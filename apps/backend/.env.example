APPLICATION_NAME=CreatorOS API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://creatoros:creatoros_password@127.0.0.1:5432/creatoros
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=creatoros_session
CSRF_COOKIE_NAME=creatoros_csrf
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
OAUTH_STATE_TTL_MINUTES=10
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/youtube/oauth/callback
YOUTUBE_ENABLE_PUBLISHING=false
YOUTUBE_HTTP_TIMEOUT_SECONDS=30
YOUTUBE_ANALYTICS_LOOKBACK_DAYS=28
